{
  "name": "@dsh-jiuwen/adapter",
  "version": "0.2.0",
  "description": "JiuwenSwarm as a dsh (DeepSeek Harness) LLM provider: route any dsh agent to a Jiuwen agent/swarm over the Gateway, with /jiuwen commands. Zero dependencies, compatibility-first.",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh",
    "cordis",
    "jiuwen",
    "jiuwenswarm",
    "llm-adapter",
    "llm-provider",
    "agent",
    "multi-agent"
  ],
  "author": "Birfy",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hsliuustc0106/dsh-jiuwen-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsliuustc0106/dsh-jiuwen-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/hsliuustc0106/dsh-jiuwen-adapter/issues"
  },
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "bin/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "ARCHITECTURE.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "mock:openai": "node bin/mock-openai.mjs",
    "mock:gateway": "node bin/mock-gateway.mjs",
    "smoke:cordis": "node scripts/cordis-load-smoke.mjs",
    "smoke:live": "node scripts/live-gateway-smoke.mjs",
    "bare-dsh": "bash scripts/bare-dsh.sh",
    "bench": "node scripts/bench.mjs",
    "bench:hard": "node scripts/bench-hard.mjs",
    "compat": "node scripts/compat-matrix.mjs --diff",
    "compat:live": "node scripts/compat-matrix.mjs --live --diff",
    "market:index": "node scripts/market-index.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
