{
  "name": "@dsh-jiuwen/adapter",
  "version": "0.1.0",
  "description": "DSH Cordis shell + JiuwenSwarm brain adapter: ctx.llm stream → Jiuwen Gateway / OpenAI-compatible AgentServer",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "jiuwen",
    "jiuwenswarm",
    "llm-adapter"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "verify:flybot": "node scripts/verify-flybot.mjs",
    "mock:openai": "node bin/mock-openai.mjs",
    "mock:gateway": "node bin/mock-gateway.mjs",
    "smoke:cordis": "node scripts/cordis-load-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
